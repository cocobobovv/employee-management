<?xml version="1.0" encoding="UTF-8"?>
<widget id="com.employee.management"
        version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets"
        xmlns:cdv="http://cordova.apache.org/ns/1.0">

    <name>员工管理系统</name>
    <description>企业员工信息管理</description>
    <author email="admin@example.com">Admin</author>

    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />

    <!-- 图标 -->
    <icon src="icons/icon-72.png" width="72" height="72" />
    <icon src="icons/icon-96.png" width="96" height="96" />
    <icon src="icons/icon-128.png" width="128" height="128" />
    <icon src="icons/icon-144.png" width="144" height="144" />
    <icon src="icons/icon-152.png" width="152" height="152" />
    <icon src="icons/icon-192.png" width="192" height="192" />
    <icon src="icons/icon-384.png" width="384" height="384" />
    <icon src="icons/icon-512.png" width="512" height="512" />

    <!-- 启动屏 -->
    <preference name="SplashScreen" value="none" />
    <preference name="AutoHideSplashScreen" value="true" />
    <preference name="FadeSplashScreen" value="false" />

    <!-- Android 配置 -->
    <platform name="android">
        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="34" />
        <preference name="AndroidWindowSplashScreenBackgroundColor" value="#4f46e5" />
        <allow-intent href="market:*" />
    </platform>

    <!-- iOS 配置 -->
    <platform name="ios">
        <preference name="target-device" value="universal" />
        <preference name="deployment-target" value="14.0" />
    </platform>
</widget>
